{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-karasu256-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "routes": [{ "pattern": "api.karasu256.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "CLOUDFLARE_IMAGES", "bucket_name": "karasu-lab-cdn" }],
  "d1_databases": [
    {
      "binding": "CDN_DB",
      "database_name": "<PRODUCTION_D1_DATABASE_NAME>",
      "database_id": "<PRODUCTION_D1_DATABASE_ID>",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "GIT_BRANCH": "main",
  },
  "preview_urls": true,
  "previews": {
    "r2_buckets": [{ "binding": "CLOUDFLARE_IMAGES", "bucket_name": "karasu-lab-cdn-dev" }],
    "d1_databases": [
      {
        "binding": "CDN_DB",
        "database_name": "<PREVIEW_D1_DATABASE_NAME>",
        "database_id": "<PREVIEW_D1_DATABASE_ID>",
        "migrations_dir": "migrations",
      },
    ],
    "vars": {
      "APP_ENV": "preview",
      "GIT_BRANCH": "preview",
    },
  },
  "env": {
    "local": {
      "routes": [],
      "r2_buckets": [{ "binding": "CLOUDFLARE_IMAGES", "bucket_name": "karasu-lab-api-local" }],
      "d1_databases": [
        {
          "binding": "CDN_DB",
          "database_name": "<LOCAL_D1_DATABASE_NAME>",
          "database_id": "<LOCAL_D1_DATABASE_ID>",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "local",
        "GIT_BRANCH": "local",
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5433/karasu256",
        "INTERNAL_API_SECRET": "local-development-internal-api-secret",
      },
    },
  },
}
