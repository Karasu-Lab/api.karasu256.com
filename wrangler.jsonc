{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-karasu256-com",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
  },
  "routes": [{ "pattern": "api.karasu256.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "CLOUDFLARE_IMAGES", "bucket_name": "cdn" }],
  "d1_databases": [
    {
      "binding": "CDN_DB",
      "database_name": "cdn-db",
      "database_id": "e93f1613-53f1-4dd5-8fc6-2621e08732b3",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "GIT_BRANCH": "main",
    "AUTH_URL": "https://api-auth.karasu256.com",
    "CDN_BASE_URL": "https://cdn.karasu256.com",
    "STORAGE_BUCKET": "cdn",
  },
  "preview_urls": true,
  "previews": {
    "r2_buckets": [{ "binding": "CLOUDFLARE_IMAGES", "bucket_name": "cdn" }],
    "d1_databases": [
      {
        "binding": "CDN_DB",
        "database_name": "cdn-db",
        "database_id": "e93f1613-53f1-4dd5-8fc6-2621e08732b3",
        "migrations_dir": "migrations",
      },
    ],
    "vars": {
      "APP_ENV": "preview",
      "GIT_BRANCH": "preview",
      "AUTH_URL": "https://dev-api-auth.karasu256.com",
      "CDN_BASE_URL": "https://dev.cdn.karasu256.com",
      "STORAGE_BUCKET": "cdn",
    },
  },
  "env": {
    "local": {
      "routes": [],
      "r2_buckets": [{ "binding": "CLOUDFLARE_IMAGES", "bucket_name": "api-local" }],
      "d1_databases": [
        {
          "binding": "CDN_DB",
          "database_name": "api-local",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "local",
        "GIT_BRANCH": "local",
        "AUTH_URL": "http://localhost:8790",
        "CDN_BASE_URL": "http://localhost:8788",
        "DATABASE_URL": "postgres://postgres:postgres@localhost:5433/karasu256",
        "INTERNAL_API_SECRET": "local-development-internal-api-secret",
        "STORAGE_ENDPOINT": "http://localhost:8333",
        "STORAGE_BUCKET": "api-local",
        "STORAGE_ACCESS_KEY_ID": "local-development-access-key-id",
        "STORAGE_SECRET_ACCESS_KEY": "local-development-secret-access-key",
      },
    },
  },
}
